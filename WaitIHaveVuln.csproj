<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WaitIHaveVuln</AssemblyName>
    <RootNamespace>WaitIHaveVuln</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DeployMod Condition="'$(DeployMod)' == ''">false</DeployMod>
    <SoloTestRow Condition="'$(SoloTestRow)' == ''">false</SoloTestRow>
    <DefineConstants Condition="'$(SoloTestRow)' == 'true'">$(DefineConstants);SOLO_TEST_ROW</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2DataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="Required game assembly not found: $(Sts2DataDir)\sts2.dll. Set Sts2InstallDir in Directory.Build.props." />
    <Error Condition="!Exists('$(Sts2DataDir)\GodotSharp.dll')" Text="Required game assembly not found: $(Sts2DataDir)\GodotSharp.dll. Set Sts2InstallDir in Directory.Build.props." />
    <Error Condition="!Exists('$(Sts2DataDir)\0Harmony.dll')" Text="Required game assembly not found: $(Sts2DataDir)\0Harmony.dll. Set Sts2InstallDir in Directory.Build.props." />
  </Target>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployMod)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup Condition="'$(Sts2InstallDir)' != '' and '$(Sts2ModsDir)' != ''">
      <_Sts2InstallDirFull>$([System.IO.Path]::GetFullPath('$(Sts2InstallDir)'))</_Sts2InstallDirFull>
      <_ExpectedSts2ModsDir>$([System.IO.Path]::GetFullPath('$(_Sts2InstallDirFull)\mods\$(MSBuildProjectName)'))</_ExpectedSts2ModsDir>
      <_ActualSts2ModsDir>$([System.IO.Path]::GetFullPath('$(Sts2ModsDir)'))</_ActualSts2ModsDir>
    </PropertyGroup>
    <Error Condition="'$(Sts2InstallDir)' == '' or !Exists('$(Sts2InstallDir)\data_sts2_windows_x86_64\sts2.dll')" Text="Deployment requires a valid Slay the Spire 2 install at Sts2InstallDir: '$(Sts2InstallDir)'." />
    <Error Condition="'$(Sts2ModsDir)' == ''" Text="Deployment requires Sts2ModsDir to be the project folder under the game's mods directory." />
    <Error Condition="'$(_ActualSts2ModsDir)' != '$(_ExpectedSts2ModsDir)'" Text="Sts2ModsDir must be the project folder directly under '$(Sts2InstallDir)\mods'. Refusing deployment to '$(_ActualSts2ModsDir)'." />
    <Error Condition="!Exists('$(TargetPath)')" Text="Built mod assembly not found: $(TargetPath)." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\WaitIHaveVuln.json')" Text="Source manifest not found: $(MSBuildProjectDirectory)\WaitIHaveVuln.json." />
    <MakeDir Directories="$(Sts2ModsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2ModsDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\WaitIHaveVuln.json" DestinationFiles="$(Sts2ModsDir)\$(AssemblyName).json" />
  </Target>
</Project>
